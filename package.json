{
  "name": "mira",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:bridge": "node scripts/gen-bridge.ts",
    "check:bridge": "node scripts/gen-bridge.ts --check",
    "icons": "node scripts/sync-icons.ts",
    "build:runtime": "node scripts/build-runtime.ts --outdir target/mira-runtime",
    "test": "node --test scripts/*.test.ts",
    "typecheck": "effect-tsgo tsrs --noEmit && pnpm -r typecheck",
    "lint": "oxlint scripts && pnpm -r lint",
    "fmt": "oxfmt scripts package.json pnpm-workspace.yaml tsconfig.json && pnpm -r fmt",
    "fmt:check": "oxfmt --check scripts package.json pnpm-workspace.yaml tsconfig.json && pnpm -r fmt:check"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "lucide-static": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "packageManager": "pnpm@11.1.1"
}
